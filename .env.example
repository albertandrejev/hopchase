# All keys are optional. Without them the scripts use public endpoints with rate-limit backoff.
# Copy to .env, fill in, then `set -a; source .env; set +a` (or export each variable).
# Keep comments on their own lines: a trailing "# …" after a value becomes part of the value in some shells.

# Solana RPC without 429s: https://helius.dev
HELIUS_API_KEY=

# Ankr: Solana RPC fallback (when HELIUS_API_KEY is unset) and EVM eth_call for the blacklist check.
# Enable Solana and Ethereum for the key in the Ankr dashboard (BNB Smart Chain is accepted but unused today).
# Chains with a public Blockscout fall back to its eth-rpc; chains without one (bsc, avalanche) print "?".
ANKR_API_KEY=

# Relay /requests/v3: https://docs.relay.link
# Without a key the keyless v2 API is used temporarily — it is sunset on 2026-11-24.
RELAY_API_KEY=

# Etherscan v2 (all EVM chains by chainid): https://etherscan.io/apis
ETHERSCAN_API_KEY=

# TronGrid higher limits: https://www.trongrid.io
TRONGRID_API_KEY=
